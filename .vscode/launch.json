{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试当前文件（课程主推）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "运行当前文件（不调试）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${fileDirname}",
      "console": "integratedTerminal",
      "noDebug": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "09 · 调试 pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}\\09_engineering",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "10 · 表达式解释器（交互 REPL）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\10_projects\\expr_interpreter\\solution.py",
      "cwd": "${workspaceFolder}\\10_projects\\expr_interpreter",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}
